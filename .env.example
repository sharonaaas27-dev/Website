# Canonical production URL used for SEO, canonical links and the sitemap.
# Server-only; do not prefix with NEXT_PUBLIC_ unless client code needs it.
SITE_URL=http://localhost:3000

# Google Apps Script web app URL that appends rows to the Google Sheet.
# See docs/google-sheets-webhook.gs for the script and setup steps.
# Include the secret as a query parameter: .../exec?token=YOUR_SECRET
ENQUIRY_WEBHOOK_URL=

# Bearer token for generic webhook providers. Not needed for Google Apps Script.
ENQUIRY_WEBHOOK_TOKEN=

# Optional fallback address shown to applicants if delivery fails.
ENQUIRY_CONTACT_EMAIL=
